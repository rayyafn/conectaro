# =====================================================================
# CONECTARO - Configurações de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com as configurações locais
# =====================================================================

# Servidor Local
PORT=8000
ENVIRONMENT=development

# Banco de Dados (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=conectaro_db
DB_USER=root
DB_PASS=

# Segurança e Sessão
SESSION_SECRET=chave_secreta_para_desenvolvimento_local
